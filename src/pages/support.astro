---
import Layout from '../layouts/Layout.astro'

const SUPPORT_EMAIL = 'soporte@frg.lat'

const faqs = [
  {
    q: '¿Cómo me uno a un viaje?',
    a: 'Pídele al organizador su código de invitación, abre Frog, ve a "Mis viajes → Unirme con código" y métela. El organizador aprobará tu solicitud.',
  },
  {
    q: '¿Frog cobra o procesa mis pagos?',
    a: 'No. Frog solo coordina el ahorro. Las transferencias SPEI van directo a la cuenta del organizador, fuera de la app.',
  },
  {
    q: '¿Cómo elimino mi cuenta y mis datos?',
    a: 'Escríbenos desde el formulario de abajo o a soporte@frg.lat y procesamos la baja en hasta 15 días hábiles.',
  },
  {
    q: 'Olvidé mi código de invitación',
    a: 'El código lo genera el organizador del viaje. Pídeselo de nuevo — puede reenviártelo desde la pantalla del viaje.',
  },
]
---
<Layout
  title="Soporte · Frog"
  description="¿Necesitas ayuda con Frog? Escríbenos y te respondemos en menos de 48 horas."
>
  <section class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-2xl">
      <p class="text-sm uppercase tracking-widest text-secondary mb-3 text-center">
        Estamos para ayudarte
      </p>
      <h1 class="text-3xl sm:text-5xl font-semibold mb-4 text-center">
        Soporte
      </h1>
      <p class="text-secondary text-center mb-10 max-w-xl mx-auto">
        ¿Tienes una duda o un problema? Llena el formulario y abriremos tu
        correo con el mensaje listo para enviar. También puedes escribirnos
        directo a
        <a href={`mailto:${SUPPORT_EMAIL}`} class="text-primary underline">{SUPPORT_EMAIL}</a>.
        Respondemos en menos de 48 horas hábiles.
      </p>

      <!-- Formulario de contacto -->
      <form id="support-form" class="bg-background border border-muted rounded-card p-6 sm:p-8 space-y-5">
        <div>
          <label for="name" class="block text-sm font-medium mb-1">Tu nombre</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-card border border-muted bg-white/60 px-4 py-2.5 outline-none focus:border-primary transition"
            placeholder="Ana López"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-1">Tu correo</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-card border border-muted bg-white/60 px-4 py-2.5 outline-none focus:border-primary transition"
            placeholder="ana@correo.com"
          />
        </div>

        <div>
          <label for="topic" class="block text-sm font-medium mb-1">Tema</label>
          <select
            id="topic"
            name="topic"
            class="w-full rounded-card border border-muted bg-white/60 px-4 py-2.5 outline-none focus:border-primary transition"
          >
            <option>Ayuda con un viaje</option>
            <option>Problema técnico / bug</option>
            <option>Eliminar mi cuenta y datos</option>
            <option>Sugerencia</option>
            <option>Otro</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-1">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-card border border-muted bg-white/60 px-4 py-2.5 outline-none focus:border-primary transition resize-y"
            placeholder="Cuéntanos qué pasó o en qué te ayudamos…"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-card bg-primary text-background font-semibold py-3 hover:opacity-90 transition"
        >
          Abrir mi correo y enviar
        </button>

        <p id="form-hint" class="text-sm text-secondary text-center" hidden>
          Abrimos tu app de correo con el mensaje listo. Si no se abrió,
          escríbenos directo a
          <a href={`mailto:${SUPPORT_EMAIL}`} class="text-primary underline">{SUPPORT_EMAIL}</a>.
        </p>
      </form>

      <!-- FAQ -->
      <h2 class="text-2xl font-semibold mt-16 mb-6">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {faqs.map(({ q, a }) => (
          <details class="bg-background border border-muted rounded-card p-4 group">
            <summary class="cursor-pointer font-medium list-none flex justify-between items-center gap-4">
              {q}
              <span class="text-secondary group-open:rotate-45 transition-transform text-xl leading-none">+</span>
            </summary>
            <p class="text-secondary leading-relaxed mt-3">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ SUPPORT_EMAIL }}>
  const form = document.getElementById('support-form')
  const hint = document.getElementById('form-hint')

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    const data = new FormData(form)
    const name = (data.get('name') || '').toString().trim()
    const email = (data.get('email') || '').toString().trim()
    const topic = (data.get('topic') || 'Soporte').toString()
    const message = (data.get('message') || '').toString().trim()

    const subject = `[Soporte Frog] ${topic}`
    const body = [
      `Nombre: ${name}`,
      `Correo: ${email}`,
      `Tema: ${topic}`,
      '',
      message,
    ].join('\n')

    const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(
      subject,
    )}&body=${encodeURIComponent(body)}`

    window.location.href = mailto
    if (hint) hint.hidden = false
  })
</script>
